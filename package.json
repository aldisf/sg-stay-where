{
  "name": "sg-stay-where",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-set-up home hunting tracker for Singapore: your criteria as a score, listings polled through your own browser, commute and amenity checks on Google Maps, and (optional, recommended) WhatsApp lead tracking.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "bin": {
    "ssw": "src/cli.js"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/cli.js serve",
    "whatsapp": "node --no-warnings=ExperimentalWarning src/cli.js whatsapp",
    "project": "node --no-warnings=ExperimentalWarning src/cli.js project",
    "privacy": "node --no-warnings=ExperimentalWarning src/cli.js privacy",
    "demo": "node --no-warnings=ExperimentalWarning src/cli.js demo",
    "demo:serve": "node --no-warnings=ExperimentalWarning src/cli.js serve --demo --no-whatsapp",
    "poll": "node --no-warnings=ExperimentalWarning src/cli.js poll",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "maplibre-gl": "6.16.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
